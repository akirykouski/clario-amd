# Clario environment. Copy to .env (git-ignored) or export in the shell. Never commit real values.
# deploy/amd/bootstrap.sh reads HF_TOKEN and VLLM_API_KEY from the shell and keeps the generated
# VLLM_API_KEY and PUBLIC_HOST in deploy/amd/.env (chmod 600, git-ignored). It never writes HF_TOKEN to disk.

# ------------------------------------------------------------------ app (backend/clario/config.py)
# patient = diary on the user's device, clinic = review server. One codebase, two modes.
CLARIO_MODE=patient
# 1 = no model calls, deterministic offline fixtures (tests, demos without an endpoint).
CLARIO_OFFLINE=0
# Where the app stores its data. Default ~/.clario (patient) or ~/.clario-clinic (clinic); /data in the container.
CLARIO_DATA_DIR=
# Listen address and port. Default 127.0.0.1 and 8765 (patient) / 8800 (clinic). The container sets 0.0.0.0 and 8800.
CLARIO_HOST=127.0.0.1
CLARIO_PORT=
# Name shown to patients when they share with this clinic.
CLARIO_CLINIC_NAME=Clario clinic
# Minutes of inactivity before the diary locks (patient mode).
CLARIO_AUTO_LOCK_MINUTES=15
# 1 = public demo server: shows a persistent "synthetic data only" banner in both apps (GET /api/health demo_instance).
CLARIO_DEMO_INSTANCE=0
# Address the patient app pre-fills on the Share page (GET /api/health clinic_url). Unset: http://localhost:8800.
CLARIO_CLINIC_URL=
# Review queue threshold. A certified eval/results/conformal_threshold.json (or the file named here) wins over
# CLARIO_REVIEW_THRESHOLD (default 0.7); a dry_run file is ignored. GET /api/health "review" shows which one is live.
CLARIO_REVIEW_CALIBRATION=
# Optional GPU telemetry. Unset: GET /api/system/gpu runs amd-smi locally if present, else returns null.
# Set to the gpu-metrics sidecar (compose sets this): http://gpu-metrics:9100/
CLARIO_GPU_METRICS_URL=
# Built frontend directory. Default <repo>/frontend/dist; the container sets /app/frontend/dist.
FRONTEND_DIST=

# ------------------------------------------------------------------ LLM client (OpenAI-compatible)
# Default is a local Ollama. On the AMD droplet compose points these at vLLM.
# AMD Token Factory (clinic and the public patient demo): LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# and LLM_API_KEY=<team key, from the secret store, never committed>. The host is detected: backend "amd-token-factory",
# model Gemma-4-31B-IT, UI label "Gemma 4 31B · AMD Token Factory", no GPU chip, 4 requests in flight (max 8),
# n separate requests for self-consistency, 429 retried after Retry-After.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Default gemma4:e4b (patient) / google/gemma-4-31B-it (clinic); Gemma-4-31B-IT on Token Factory (ids are case-sensitive).
LLM_MODEL=
# token-factory = treat the endpoint as AMD Token Factory even behind another host (a proxy). Unset/auto = detect by host.
LLM_BACKEND=
# 1 = the endpoint is vLLM on an AMD Instinct GPU (labels the backend "amd-vllm" in the UI).
LLM_IS_AMD=0
# Parallel model calls per app. Default 8; on Token Factory default 4, capped at 8 (the key is shared by the team).
LLM_CONCURRENCY=
# Lab report pages. OCR model for POST {LLM_BASE_URL}/ocr: page -> markdown. Default MinerU2.5-Pro on Token Factory,
# unset elsewhere; off = always send the page image to the chat model.
LLM_OCR_MODEL=
# After OCR: table (default) = a recognised result table is read in code, one request per page; pages without one go
# to LLM_MODEL. model = LLM_MODEL (Gemma 4 31B) structures every page (two requests per page, slower).
CLARIO_DOC_STRUCTURE=
# Chat model that reads page images (the path without OCR, and the fallback when OCR fails). Default LLM_MODEL.
LLM_VISION_MODEL=
# Structuring samples per page (self-consistency). Default 3; 1 on Token Factory, where rows not found in the OCR text
# go to the clinician instead.
CLARIO_DOC_SAMPLES=

# ------------------------------------------------------------------ AMD droplet (deploy/amd)
# Hugging Face token. Gemma 4 is gated: accept the license on the model page first. Read-only token is enough.
HF_TOKEN=
# Bearer token for the vLLM servers and the apps' LLM_API_KEY. Generate: openssl rand -hex 24
VLLM_API_KEY=
# Public hostname for HTTPS. Default <droplet-ip>.sslip.io. The clinic console is served at clinic.<PUBLIC_HOST>.
PUBLIC_HOST=
# vLLM ROCm image. Pinned to a tag verified on Docker Hub 2026-10-12; fall back to :latest or :nightly if it will not start Gemma 4.
VLLM_IMAGE=vllm/vllm-openai-rocm:v0.31.0
# Model cache on the droplet (defaults to ~/.cache/huggingface).
HF_CACHE=
# Big model (clinic, synthetic data, bench) and small model (patient demo, fine-tune base).
BIG_MODEL=google/gemma-4-31B-it
SMALL_MODEL=google/gemma-4-E4B-it
# Model name the patient demo asks for. Set to clario-extract to use the LoRA adapter once eval shows it wins.
PATIENT_LLM_MODEL=google/gemma-4-E4B-it
# Share of the 192 GB card per vLLM process. Must sum to well under 1.0 (default 0.62 + 0.22).
BIG_GPU_UTIL=0.62
SMALL_GPU_UTIL=0.22
BIG_MAX_MODEL_LEN=16384
BIG_MAX_NUM_SEQS=64
SMALL_MAX_MODEL_LEN=8192
SMALL_MAX_NUM_SEQS=32
# Extra raw vLLM flags, e.g. "--attention-backend TRITON_ATTN" if Gemma 4 fails on the default attention backend.
BIG_EXTRA_ARGS=
SMALL_EXTRA_ARGS=
# Alternative to the flag above: export VLLM_ATTENTION_BACKEND=TRITON_ATTN (passed through to both vLLM containers).
# (Left commented: an empty value would be passed to the container as an empty string.)
# VLLM_ATTENTION_BACKEND=TRITON_ATTN
# 1 enables ROCm AITER kernels. Off by default (unverified for Gemma 4).
VLLM_ROCM_USE_AITER=0
# Fine-tuned extractor. Host dir with adapter_config.json (bootstrap uses train/out/e4b-r16/adapter if it exists).
LORA_PATH=
LORA_RANK=16
# Compose wiring set by bootstrap.sh when an adapter exists; set by hand only when running compose directly.
SMALL_LORA_ARGS=
# bootstrap.sh: redo finished stages. WAIT_SECS: how long to wait for a model to load.
FORCE=0
WAIT_SECS=2400
# deploy/docker-compose.clinic.yml (clinic-only stack) only:
CLINIC_DOMAIN=
